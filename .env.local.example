ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Formspree endpoint for emailing dad's profile answers to Ellie.
# Create a form at formspree.io and paste the endpoint URL here.
# Must also be added to Vercel → Settings → Environment Variables (Production + Preview).
# The NEXT_PUBLIC_ prefix is required so the browser-side form component can read it.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
